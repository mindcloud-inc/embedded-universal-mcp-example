# Copy this file to .env.local and fill in the keys. Restart `npm run dev`
# after you change it. Every value stays on the server.

# Your MindCloud API key. Creating an end user (POST /v1/users) needs a Full
# Access key. Without a key the agent runs with no MindCloud tools.
MINDCLOUD_API_KEY=

# Where MindCloud runs. A local MindCloud stack is http://localhost:9801.
MINDCLOUD_API_BASE_URL=https://connect.mindcloud.co

# Your Vercel AI Gateway key. The chat does not start without it.
AI_GATEWAY_API_KEY=

# The model the agent uses, as an AI Gateway "provider/model" id.
AI_MODEL=anthropic/claude-sonnet-5
